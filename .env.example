# Copy this file to .env and fill in your key. Never commit .env.

# Required for answers and embeddings. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional settings (defaults shown)
# GENERATION_MODEL=gemini-3.5-flash-lite
# EMBEDDING_PROVIDER=gemini          # "local": offline word-hashing vectors, for tests only
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSIONS=768
# THINKING_LEVEL=                    # minimal, low, medium or high (model default if empty)
# CHUNK_SIZE=1000                    # characters per passage
# CHUNK_OVERLAP=150                  # characters repeated between consecutive passages
# TOP_K=5                            # passages sent to the model
# MIN_RELEVANCE=0.0                  # cosine similarity below which a passage is ignored
# MAX_FILE_MB=10
# MAX_PAGES=300
# DATA_DIR=data                      # index (data/index) and uploaded files (data/storage)
# PUBLIC_DEMO=false                  # true: per-visitor uploads, question and upload limits
# LOG_LEVEL=INFO
# LOG_CONTENT=false                  # true logs questions and answers (local debugging only)
